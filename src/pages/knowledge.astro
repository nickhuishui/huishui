---
import BaseLayout from "../layouts/BaseLayout.astro";
import { knowledgeItems } from "../data/knowledge";
import { withBase } from "../lib/paths";

const groups = [
  {
    id: "tools",
    label: "写作与工具",
    items: knowledgeItems.filter((item) => item.category === "写作与工具"),
  },
  {
    id: "physics",
    label: "物理笔记",
    items: knowledgeItems.filter((item) => item.category === "物理笔记"),
  },
  {
    id: "english",
    label: "英语学习",
    items: knowledgeItems.filter((item) => item.category === "英语学习"),
  },
];
---

<BaseLayout title="知识库 | 辉水先生的个人主页" sideBarActiveItemID="knowledge">
  <section class="grid gap-8">
    <header class="rounded-lg border border-base-300 bg-base-100 p-6 md:p-8">
      <div class="text-sm font-bold uppercase tracking-[0.2em] text-base-content/60">Knowledge Library</div>
      <h1 class="mt-3 text-4xl font-bold">知识库</h1>
      <p class="mt-4 max-w-3xl leading-8 text-base-content/75">
        这里放置我自己写的短文档和学习笔记。第一版以 PDF 为主，后续可以逐步扩展为系列文章、小册子或完整书稿。
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a class="badge badge-outline p-3" href="#all">全部</a>
        {groups.map((group) => <a class="badge badge-outline p-3" href={`#${group.id}`}>{group.label}</a>)}
      </div>
    </header>

    <section id="all" class="grid gap-4">
      <h2 class="text-2xl font-bold">全部文档</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          knowledgeItems.map((item) => (
            <article class="rounded-lg border border-base-300 bg-base-100 p-5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="badge badge-neutral">{item.category}</span>
                <span class="badge badge-outline">{item.fileType}</span>
                <span class="text-sm text-base-content/60">{item.size}</span>
              </div>
              <h3 class="mt-3 text-xl font-bold">{item.title}</h3>
              <p class="mt-2 leading-7 text-base-content/70">{item.summary}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {item.tags.map((tag) => <span class="badge badge-ghost">{tag}</span>)}
              </div>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <time class="text-sm text-base-content/60">{item.updatedAt}</time>
                <div class="flex gap-2">
                  <a class="btn btn-sm btn-primary" href={withBase(item.file)} target="_blank">在线阅读</a>
                  <a class="btn btn-sm btn-outline" href={withBase(item.file)} download>下载</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      groups.map((group) => (
        <section id={group.id} class="grid gap-4">
          <h2 class="text-2xl font-bold">{group.label}</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {group.items.map((item) => (
              <article class="rounded-lg border border-base-300 bg-base-100 p-5">
                <h3 class="text-xl font-bold">{item.title}</h3>
                <p class="mt-2 leading-7 text-base-content/70">{item.summary}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <a class="btn btn-sm btn-primary" href={withBase(item.file)} target="_blank">在线阅读</a>
                  <a class="btn btn-sm btn-outline" href={withBase(item.file)} download>下载</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

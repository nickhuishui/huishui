        <div class="text-sm text-base-content/60">Email</div>
        <div class="mt-2 break-all text-xl font-bold">yantumanman@163.com</div>
      </a>
      <a class="rounded-lg border border-base-300 bg-base-100 p-5 transition hover:shadow-md" href="mailto:renhuitao2026@gmail.com">
        <div class="text-sm text-base-content/60">Email</div>

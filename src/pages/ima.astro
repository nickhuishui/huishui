---
import BaseLayout from "../layouts/BaseLayout.astro";
import { imaKnowledgeBases } from "../data/ima";

const topics = Array.from(new Set(imaKnowledgeBases.map((item) => item.topic)));
---

<BaseLayout title="IMA 知识库 | 任辉涛的个人主页" sideBarActiveItemID="ima">
  <section class="grid gap-8">
    <header class="rounded-lg border border-base-300 bg-base-100 p-6 md:p-8">
      <div class="text-sm font-bold uppercase tracking-[0.2em] text-base-content/60">IMA Knowledge Bases</div>
      <h1 class="mt-3 text-4xl font-bold">IMA 知识库</h1>
      <p class="mt-4 max-w-3xl leading-8 text-base-content/75">
        这里放置 IMA 中已经整理好的外部知识库入口。它和站内 PDF 知识库互补，适合承载更大的资料集合和持续更新的主题库。
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        {topics.map((topic) => <span class="badge badge-outline p-3">{topic}</span>)}
      </div>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {
        imaKnowledgeBases.map((base) => (
          <article class="rounded-lg border border-base-300 bg-base-100 p-5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge badge-neutral">{base.source}</span>
              <span class="badge badge-outline">{base.topic}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold">{base.title}</h2>
            <p class="mt-2 leading-7 text-base-content/70">{base.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {base.tags.map((tag) => <span class="badge badge-ghost">{tag}</span>)}
            </div>
            <div class="mt-5">
              <a class="btn btn-sm btn-primary" href={base.url} target="_blank" rel="noreferrer">打开知识库</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

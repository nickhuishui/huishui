---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
import { withBase } from "../lib/paths";
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li><a class="py-3 text-base" id="home" href={withBase()}>首页</a></li>
    <li><a class="py-3 text-base" id="knowledge" href={withBase("knowledge")}>知识库</a></li>
    <li><a class="py-3 text-base" id="wechat" href={withBase("wechat")}>公众号合集</a></li>
    <li><a class="py-3 text-base" id="ima" href={withBase("ima")}>IMA 知识库</a></li>
    <li><a class="py-3 text-base" id="blog" href={withBase("blog/")}>博客</a></li>
    <li><a class="py-3 text-base" id="cv" href={withBase("cv")}>关于</a></li>
    <li>
        <a
            class="py-3 text-base"
            href="mailto:yantumanman@163.com"
            referrerpolicy="no-referrer-when-downgrade">联系</a
        >
    </li>
</ul>

<script is:inline define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
